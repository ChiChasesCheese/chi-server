#!/usr/bin/env bash
# chi —— chi-service 的唯一入口。所有操作都从这里走，具体逻辑在 scripts/ 里。
set -euo pipefail

CHI_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=../scripts/lib.sh
. "$CHI_ROOT/scripts/lib.sh"

usage() {
  cat <<EOF
用法: bin/chi <命令> [参数]

装机（按顺序，都可重复执行）
  init                  生成 .env（自动填时区、随机密钥），已存在则只补缺的键
  bootstrap [步骤...]   装机：brew macos runtime tailscale ollama（默认全跑）
  doctor                体检：电源、防火墙、SSH、FileVault、Tailscale、Docker、各服务

服务（stack = stacks/ 下的一个目录；不写就是 .env 里 CHI_STACKS 的全部）
  up [stack...]         启动
  down [stack...]       停止
  restart [stack...]    重启
  ps [stack...]         状态
  logs <stack> [svc]    跟日志（Ctrl-C 退出）
  update [--no-brew]    升级 brew 包 + 拉新镜像并重建容器
  serve [apply|status|reset]  用 tailscale serve 把服务以 HTTPS 暴露到你的 tailnet

数据
  backup [init|run|snapshots|check]  restic 备份 \$DATA_DIR（默认 run）
  schedule [install|uninstall]       安装/卸载 launchd 定时任务（每日备份）

可用 stack: $(all_stacks | tr '\n' ' ')
EOF
}

for_stacks() {
  local action="$1"; shift
  local s
  for s in $(resolve_stacks "$@"); do
    log "$s: $action"
    case "$action" in
      up)      compose "$s" up -d --remove-orphans ;;
      down)    compose "$s" down ;;
      restart) compose "$s" restart ;;
      ps)      compose "$s" ps ;;
    esac
  done
}

cmd="${1:-help}"
[ "$#" -gt 0 ] && shift

case "$cmd" in
  init)       exec "$CHI_ROOT/scripts/init-env.sh" "$@" ;;
  bootstrap)  exec "$CHI_ROOT/scripts/bootstrap.sh" "$@" ;;
  doctor)     exec "$CHI_ROOT/scripts/doctor.sh" "$@" ;;
  update)     exec "$CHI_ROOT/scripts/update.sh" "$@" ;;
  serve)      exec "$CHI_ROOT/scripts/tailscale-serve.sh" "$@" ;;
  backup)     exec "$CHI_ROOT/scripts/backup.sh" "$@" ;;
  schedule)   exec "$CHI_ROOT/scripts/schedule.sh" "$@" ;;
  up|down|restart|ps)
    load_env
    require_docker
    if [ "$cmd" = up ]; then
      for s in $(resolve_stacks "$@"); do
        if [ -x "$CHI_ROOT/stacks/$s/pre-up.sh" ]; then "$CHI_ROOT/stacks/$s/pre-up.sh"; fi
      done
    fi
    for_stacks "$cmd" "$@"
    ;;
  logs)
    [ "$#" -ge 1 ] || die "用法: chi logs <stack> [service]"
    load_env
    require_docker
    stack="$1"; shift
    compose "$stack" logs -f --tail=200 "$@"
    ;;
  help|-h|--help) usage ;;
  *) usage; exit 1 ;;
esac
