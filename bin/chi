#!/usr/bin/env bash
# chi - the single entry point. Every operation goes through here; the logic lives in scripts/.
set -euo pipefail

CHI_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=../scripts/lib.sh
. "$CHI_ROOT/scripts/lib.sh"

usage() {
  cat <<EOF
Usage: bin/chi <command> [args]

Setup (in order; all idempotent)
  init                  create .env (timezone, random secrets); on an existing .env only fills missing keys
  bootstrap [step...]   provision: dotfiles brew macos runtime tailscale ollama (default: all)
  unattended            survive reboots unattended: FileVault off, auto-login, lock at login (interactive: ssh -t)
  doctor                health check on the server: power, firewall, SSH, Tailscale, Docker, every stack
  remote-check [host]   end-to-end check from a client machine, as a user would see it (default host: chi-mini)

Stacks (a stack = a directory under stacks/; no argument = all of CHI_STACKS in .env)
  stacks                list available stacks and which are enabled
  up [stack...]         start
  down [stack...]       stop
  restart [stack...]    restart
  ps [stack...]         status
  logs <stack> [svc]    follow logs (Ctrl-C to quit)
  update [--no-brew]    upgrade Homebrew packages, pull new images, recreate containers
  serve [apply|status|reset]  expose stacks over HTTPS on your tailnet (tailscale serve)

Media & sharing
  fetch <url> [folder]  queue a download in MeTube (YouTube and anything else yt-dlp supports)
  media [usage|clean|scan|sub|iptv]  library usage / cleanup / rescan / subscriptions / IPTV channels
  onboard               generate the onboarding page (tailnet :8008) and a ready-to-send invite

Network & devices
  proxy [install|apply|test|status|logs]  split-routing proxy (mihomo): only listed sites use the upstream
  tv [connect|install|proxy|vpn|apps|shell]  manage an Android TV / Google TV box over adb

Data & schedules
  backup [init|run|snapshots|check]  restic backup of \$DATA_DIR (default: run)
  schedule [install|uninstall]       install/remove launchd jobs (backup, media cleanup, heartbeat)

Available stacks: $(all_stacks | tr '\n' ' ')
EOF
}

for_stacks() {
  local action="$1"; shift
  local s
  for s in $(resolve_stacks "$@"); do
    log "$s: $action"
    case "$action" in
      up)      compose "$s" up -d --remove-orphans ;;
      down)    compose "$s" down ;;
      restart) compose "$s" restart ;;
      ps)      compose "$s" ps ;;
    esac
  done
}

list_stacks() {
  local enabled=" " s mark
  if [ -f "$CHI_ROOT/.env" ]; then load_env; enabled=" $(resolve_stacks) "; fi
  for s in $(all_stacks); do
    case "$enabled" in *" $s "*) mark="*" ;; *) mark=" " ;; esac
    printf ' %s %-12s %s\n' "$mark" "$s" "$(stack_conf "$s" DESCRIPTION)"
  done
  echo "   (* = enabled in CHI_STACKS)"
}

cmd="${1:-help}"
[ "$#" -gt 0 ] && shift

case "$cmd" in
  init)         exec "$CHI_ROOT/scripts/init-env.sh" "$@" ;;
  bootstrap)    exec "$CHI_ROOT/scripts/bootstrap.sh" "$@" ;;
  doctor)       exec "$CHI_ROOT/scripts/doctor.sh" "$@" ;;
  remote-check) exec "$CHI_ROOT/scripts/remote-check.sh" "$@" ;;
  unattended)   exec "$CHI_ROOT/scripts/unattended.sh" "$@" ;;
  update)       exec "$CHI_ROOT/scripts/update.sh" "$@" ;;
  serve)        exec "$CHI_ROOT/scripts/tailscale-serve.sh" "$@" ;;
  backup)       exec "$CHI_ROOT/scripts/backup.sh" "$@" ;;
  schedule)     exec "$CHI_ROOT/scripts/schedule.sh" "$@" ;;
  proxy)        exec "$CHI_ROOT/scripts/proxy.sh" "$@" ;;
  fetch)        exec "$CHI_ROOT/scripts/media.sh" fetch "$@" ;;
  media)        exec "$CHI_ROOT/scripts/media.sh" "$@" ;;
  onboard)      exec "$CHI_ROOT/scripts/onboard.sh" "$@" ;;
  tv)           exec "$CHI_ROOT/scripts/tv.sh" "$@" ;;
  stacks)       list_stacks ;;
  up|down|restart|ps)
    load_env
    require_docker
    if [ "$cmd" = up ]; then
      for s in $(resolve_stacks "$@"); do
        if [ -x "$CHI_ROOT/stacks/$s/pre-up.sh" ]; then "$CHI_ROOT/stacks/$s/pre-up.sh"; fi
      done
    fi
    for_stacks "$cmd" "$@"
    ;;
  logs)
    [ "$#" -ge 1 ] || die "Usage: chi logs <stack> [service]"
    load_env
    require_docker
    stack="$1"; shift
    compose "$stack" logs -f --tail=200 "$@"
    ;;
  help|-h|--help) usage ;;
  *) usage; exit 1 ;;
esac
