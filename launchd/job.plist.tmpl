<?xml version="1.0" encoding="UTF-8"?>
<!-- Generic launchd job template: scripts/schedule.sh fills in the double-underscore placeholders and installs it into ~/Library/LaunchAgents/ -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>__LABEL__</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__CHI_ROOT__/bin/chi</string>
    <string>__CMD__</string>
    <string>__SUB__</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- launchd's PATH is minimal; add Homebrew and OrbStack by hand -->
    <key>PATH</key>
    <string>/opt/homebrew/bin:/opt/homebrew/sbin:__HOME__/.orbstack/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>__HOUR__</integer>
    <key>Minute</key>
    <integer>__MINUTE__</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/chi-service/__NAME__.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/chi-service/__NAME__.log</string>
  <!-- Low priority: don't compete with the services for CPU / IO -->
  <key>LowPriorityIO</key>
  <true/>
  <key>Nice</key>
  <integer>10</integer>
</dict>
</plist>
