  @media (prefers-color-scheme: dark) { :root { --bg:#111113; --fg:#f2f2f5; --muted:#a1a1a6; --card:#1c1c1f; --line:#2c2c30; --accent:#4ea1ff; --code:#26262a; } }
  * { box-sizing: border-box; }
