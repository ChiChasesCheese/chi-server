# chi-service 全局配置。复制成 .env 后修改：bin/chi init 会自动做这一步并填好随机密钥。
# .env 已在 .gitignore 里，永远不要提交它。

# ---------- 机器 ----------
# 主机名：会同时用于 macOS 的 HostName/LocalHostName 和 Tailscale 节点名
CHI_HOSTNAME=chi-mini
# 时区（init 会从系统读取）
TZ=Asia/Shanghai

# 启用哪些 stack（空格分隔，对应 stacks/ 下的目录）
#   core        Homepage 首页 + Uptime Kuma 监控 + Dozzle 日志
#   ai          Open WebUI（前端），Ollama 跑在宿主机上用 Metal GPU
#   automation  n8n 工作流自动化
#   vault       Vaultwarden 密码管理（Bitwarden 兼容）
#   photos      Immich 相册（Google Photos 替代，吃内存和硬盘，256GB 机器别开）
#   media       Jellyfin 影音库 + MeTube 下载器（小型 NAS，投影/电视盒子看）
#   public      Cloudflare Tunnel：把个别网页/API 公开到互联网（默认不开，见 docs/public.md）
CHI_STACKS="core ai media"

# 容器运行时：orbstack（推荐，个人免费，闭源）| colima（纯开源）
CHI_RUNTIME=orbstack

# ---------- 网络 ----------
# 容器端口绑定到哪个地址：
#   127.0.0.1  只有本机能访问，外部统一走 `chi serve`（Tailscale HTTPS）—— 推荐
#   0.0.0.0    局域网里任何设备都能直接 http://<ip>:<port> 访问（没装 Tailscale 的家人用）
BIND_ADDR=127.0.0.1
# Tailscale 给这台机器的完整域名，形如 chi-mini.tail1234.ts.net
# 跑完 `chi bootstrap tailscale` 后 `chi init` 会自动填上
TS_FQDN=

# ---------- 公网（public stack，Cloudflare Tunnel，见 docs/public.md） ----------
# 只有“确实要给没装 Tailscale 的人 / 第三方回调访问”的东西才走这里；自己用一律走 Tailscale。
# 拿 token：
#   1. 域名先托管到 Cloudflare（免费版即可）
#   2. Cloudflare 后台 → Networking → Tunnels → Create a tunnel
#      （旧版界面叫 Zero Trust → Networks → Tunnels）→ 起个名字（如 chi-mini）
#      → 环境选 Docker → 复制命令里 --token 后面那一长串，填到下面
#   3. 同一个隧道的 Routes（旧版叫 Public Hostname）里加一条：
#      子域名随意（如 hello），Service 填 http://hello:80
#      以后的应用同理：http://<compose 里的服务名>:<容器端口>，不要填 localhost / host.docker.internal
#   4. CHI_STACKS 里加上 public → chi up public
# token 就是这个隧道的钥匙（拿到就能冒充你的入口），别外传；泄露了就在后台删掉隧道重建。
# 留空 = 不连 Cloudflare，public stack 只跑本机示例应用。
CF_TUNNEL_TOKEN=
# 公开用的完整域名（如 hello.example.com），只用于 Homepage「公网」卡片的链接；留空不影响隧道
PUBLIC_DOMAIN=

# ---------- 数据 ----------
# 所有服务的持久化数据都放这里（不在仓库里）。备份的就是这个目录。
DATA_DIR=/Users/CHANGE_ME/srv/data

# ---------- 媒体库（media stack，见 docs/media.md） ----------
# 影音文件放哪。以后买了外置盘就改成 /Volumes/<盘名>/media
MEDIA_DIR=/Users/CHANGE_ME/srv/data/media
# Downloads/ 最多占多少 GB，超了每天凌晨从最旧的开始删。256GB 的机器建议 ≤ 60
MEDIA_MAX_GB=60
# 下载的最高分辨率（省空间；投影是 4K 的话可以改 2160，但一个视频就是几 GB）
MEDIA_MAX_HEIGHT=1080
# Jellyfin 端口对谁开放：0.0.0.0 = 局域网（onn 盒子要用）；127.0.0.1 = 只走 Tailscale
MEDIA_BIND_ADDR=0.0.0.0
# 可选：Jellyfin 后台 → 控制台 → API 密钥。填了 chi media scan / iptv 才能用
JELLYFIN_API_KEY=
# 直播源（M3U，空格分隔）。留空 = iptv-org 的中国频道。chi media iptv 会逐个试播，只留能播的
IPTV_M3U_URLS=

# ---------- 告警 ----------
# ntfy 推送：手机装 ntfy App 订阅这个 topic。ntfy.sh 公共服务器上 topic 名就是“密码”，起个难猜的（chi init 会生成）
NTFY_TOPIC=
# 外部心跳（healthchecks.io 的 ping URL）：mini 整机掉线时由外部服务报警。填了之后 chi schedule 会每 5 分钟 ping 一次
HC_PING_URL=

# ---------- 备份（restic） ----------
# 本地外置盘示例：/Volumes/Backup/restic-chi
# Backblaze B2 示例：b2:my-bucket:chi-service（同时填 B2_ACCOUNT_ID / B2_ACCOUNT_KEY）
# S3 兼容（R2 等）示例：s3:https://<account>.r2.cloudflarestorage.com/chi-service
# 留空 = 不启用备份（chi schedule 不装每日备份任务）
RESTIC_REPOSITORY=
# 密码放在单独文件里（init 会生成）。丢了这个文件 = 备份全部作废，务必存进你的密码管理器
RESTIC_PASSWORD_FILE=/Users/CHANGE_ME/.config/chi/restic-password
# B2_ACCOUNT_ID=
# B2_ACCOUNT_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# 每天几点跑备份（launchd，24 小时制）
BACKUP_HOUR=4

# ---------- 回国分流（chi proxy，见 docs/china-media.md） ----------
# 你的回国 VPN 提供的 Clash / Clash Meta 订阅地址（相当于密码，别外传）
# ⚠️ 一定用单引号包起来：订阅地址里常有 & ，不加引号 .env 会解析出错
CLASH_SUBSCRIPTION_URL=''
# 从订阅里挑哪些节点（正则，不区分大小写）。全是回国节点的订阅可以写 '.*'
CLASH_CN_FILTER='(?i)中国|大陆|回国|china|\bcn\b|上海|北京|广州|深圳|杭州|成都'
CLASH_PORT=7890

# ---------- 各服务密钥（init 自动生成，别手填） ----------
OPEN_WEBUI_SECRET_KEY=
N8N_ENCRYPTION_KEY=
# mihomo 管理面板密钥
CLASH_SECRET=
# Vaultwarden：先设 true 注册自己的账号，然后改回 false 并 `chi up vault`
VAULTWARDEN_SIGNUPS_ALLOWED=false
