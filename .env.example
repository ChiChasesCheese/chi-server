# chi-server global config. Copy to .env and edit: `bin/chi init` does this for you and fills in
# random secrets. .env is in .gitignore - never commit it.

# ==================== Core ====================
# Hostname: used for macOS HostName/LocalHostName and as the Tailscale node name
CHI_HOSTNAME=chi-mini
# Time zone, e.g. America/New_York. Auto-detected by `chi init`; falls back to UTC
TZ=
# Container runtime: orbstack (recommended, free for personal use, closed source) | colima (fully open source)
CHI_RUNTIME=orbstack
# Persistent data for every service lives here (outside the repo). This is the directory that gets backed up.
DATA_DIR=/Users/CHANGE_ME/srv/data

# ==================== Stacks ====================
# Which stacks to enable (space-separated, matching directories under stacks/)
#   core        Homepage dashboard + Uptime Kuma monitoring + Dozzle logs
#   ai          Open WebUI (frontend); Ollama runs on the host to use the Metal GPU
#   automation  n8n workflow automation
#   vault       Vaultwarden password manager (Bitwarden compatible)
#   photos      Immich photo library (Google Photos replacement; heavy on RAM and disk, skip on 256GB machines)
#   media       Jellyfin media library + MeTube downloader (small NAS for a TV / projector)
#   public      Cloudflare Tunnel: publish selected pages/APIs to the internet (off by default, see docs/public.md)
CHI_STACKS="core ai media"

# ==================== Tailscale / network ====================
# Address container ports bind to:
#   127.0.0.1  Local only; outside access goes through `chi serve` (Tailscale HTTPS) - recommended
#   0.0.0.0    Any LAN device can open http://<ip>:<port> directly (for household members without Tailscale)
BIND_ADDR=127.0.0.1
# This machine's full Tailscale DNS name, like chi-mini.your-tailnet.ts.net
# Filled in by `chi init` after `chi bootstrap tailscale`
TS_FQDN=

# ==================== Alerts ====================
# ntfy push: subscribe to this topic in the ntfy app. On the public ntfy.sh server the topic name is
# the password, so make it hard to guess (chi init generates one)
NTFY_TOPIC=
# External heartbeat (healthchecks.io ping URL): an outside service alerts you when the whole machine
# goes offline. When set, chi schedule pings it every 5 minutes
HC_PING_URL=

# ==================== Backup (restic) ====================
# Local external disk example: /Volumes/Backup/restic-chi
# Backblaze B2 example: b2:my-bucket:chi-server (also set B2_ACCOUNT_ID / B2_ACCOUNT_KEY)
# S3-compatible (R2 etc.) example: s3:https://<account>.r2.cloudflarestorage.com/chi-server
# Empty = backups disabled (chi schedule does not install the daily backup job)
RESTIC_REPOSITORY=
# Password lives in its own file (generated by init). Lose this file = every backup is useless,
# so store it in your password manager
RESTIC_PASSWORD_FILE=/Users/CHANGE_ME/.config/chi/restic-password
# B2_ACCOUNT_ID=
# B2_ACCOUNT_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Hour of day to run the backup (launchd, 24-hour clock)
BACKUP_HOUR=4

# ==================== Public (public stack, Cloudflare Tunnel, see docs/public.md) ====================
# Only for things that must be reachable by people without Tailscale or by third-party callbacks;
# everything you use yourself goes through Tailscale.
# Getting a token:
#   1. Move your domain's DNS to Cloudflare (the free plan is enough)
#   2. Cloudflare dashboard -> Networking -> Tunnels -> Create a tunnel
#      (older UI: Zero Trust -> Networks -> Tunnels) -> give it a name (e.g. chi-mini)
#      -> choose Docker -> copy the long string after --token in the command and paste it below
#   3. In the same tunnel's Routes (older UI: Public Hostname), add one:
#      any subdomain (e.g. hello), Service = http://hello:80
#      Future apps work the same way: http://<compose service name>:<container port>;
#      never localhost / host.docker.internal
#   4. Add public to CHI_STACKS -> chi up public
# The token is the key to this tunnel (anyone holding it can impersonate your entry point); keep it
# private. If it leaks, delete the tunnel in the dashboard and create a new one.
# Empty = no Cloudflare connection; the public stack only runs the local example app.
CF_TUNNEL_TOKEN=
# Full public hostname (e.g. hello.example.com), only used for the link on the Homepage "Public" card;
# leaving it empty does not affect the tunnel
PUBLIC_DOMAIN=

# ==================== Media (media stack, see docs/media.md) ====================
# Where media files live. With an external disk later, change to /Volumes/<disk>/media
MEDIA_DIR=/Users/CHANGE_ME/srv/data/media
# Max GB for Downloads/; when exceeded, the oldest files are deleted every night. On a 256GB machine
# keep it <= 60
MEDIA_MAX_GB=60
# Max download resolution (saves space; set 2160 for a 4K screen, but one video is then several GB)
MEDIA_MAX_HEIGHT=1080
# Who can reach Jellyfin: 0.0.0.0 = LAN (needed by TV boxes without Tailscale); 127.0.0.1 = Tailscale only
MEDIA_BIND_ADDR=0.0.0.0
# Optional: Jellyfin admin -> Dashboard -> API Keys. Required by chi media scan / iptv
JELLYFIN_API_KEY=
# Live TV sources (M3U, space-separated). Empty = iptv-org's China channels. chi media iptv test-plays
# each channel and keeps only the working ones
IPTV_M3U_URLS=

# ==================== Proxy (chi proxy, see docs/china-media.md) ====================
# Clash / Clash Meta subscription URL from your China-exit VPN provider (treat it like a password)
# Always wrap it in single quotes: subscription URLs often contain &, which breaks .env parsing unquoted
CLASH_SUBSCRIPTION_URL=''
# Which nodes to pick from the subscription (regex). If every node in the subscription exits in
# mainland China, use '.*'. The default only matches ASCII node names; if your provider names nodes
# in Chinese, add those names (or the CN flag emoji) to the regex
CLASH_CN_FILTER='(?i)china|mainland|\bcn\b|shanghai|beijing|guangzhou|shenzhen|hangzhou|chengdu'
CLASH_PORT=7890

# ==================== Dotfiles (optional) ====================
# Optional chezmoi repo, e.g. github-user/dotfiles; applied by `chi bootstrap dotfiles`
DOTFILES_REPO=
# Optional branch for DOTFILES_REPO (empty = the repo's default branch)
DOTFILES_BRANCH=

# ==================== Service secrets (generated by init, do not fill in by hand) ====================
OPEN_WEBUI_SECRET_KEY=
N8N_ENCRYPTION_KEY=
# mihomo dashboard secret
CLASH_SECRET=
# Vaultwarden: set true to register your own account, then set it back to false and run `chi up vault`
VAULTWARDEN_SIGNUPS_ALLOWED=false
