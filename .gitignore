# Secrets and machine-local state - never commit
.env
*.env.local
stacks/*/.env

# Files pulled from upstream (generated by fetch.sh)
stacks/photos/compose.yaml
stacks/photos/example.env

# Runtime data defaults to ~/srv/data, outside the repo; this guards against DATA_DIR set inside it
data/

.DS_Store

# Homepage adds default files and logs to its config dir on first start
stacks/core/homepage/logs/
stacks/core/homepage/custom.css
stacks/core/homepage/custom.js
stacks/core/homepage/kubernetes.yaml
stacks/core/homepage/proxmox.yaml
.playwright-mcp/

# Python bytecode (py_compile in CI, scripts/*.py)
__pycache__/
